<!doctype html><html lang="en"><head><link rel="icon" href="data:,"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Riptide — The Sun, Again</title>
<style>
@font-face{font-family:Instrument;src:url(@@FONT@@)}*{box-sizing:border-box}html{color-scheme:dark;background:#121315;color:#f1e7d5;font-family:Instrument,"PingFang SC",sans-serif}body{margin:0}main{width:min(96vw,1450px);margin:0 auto;padding:24px 0}
header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px}h1{font-weight:560;letter-spacing:-.055em;margin:0;font-size:clamp(22px,3vw,38px)}h1 span{font:500 .61em "PingFang SC",sans-serif;letter-spacing:.1em;margin-left:.66em;color:#d6ad82}time{font-size:14px;font-variant-numeric:tabular-nums;color:#c0b7a8}
#stage{position:relative;aspect-ratio:16/9;overflow:hidden;background:#191817}canvas{display:block;width:100%;height:100%}#notice{position:absolute;inset:0;display:grid;place-content:center;background:#1c1917}#notice[hidden]{display:none}
nav{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}button{background:transparent;color:#d4cabe;border:1px solid #3c3936;padding:7px 12px;border-radius:2px;font:inherit;font-size:13px;cursor:pointer}button:hover,button[aria-current=step]{color:#fff1d1;border-color:#bc7d55}#play{background:#e4c49b;color:#241f1a;border-color:transparent;min-width:64px}input{width:100%;accent-color:#e1a770;display:block;margin:12px 0 0;cursor:pointer}#chapters{display:contents}#fs{margin-left:auto}#view{width:100%;height:100%}html.render main,html.render #stage{padding:0;margin:0;width:100vw;height:100vh;max-width:none}html.render header,html.render #controls{display:none}#stage:fullscreen{display:grid;place-content:center;background:#0a0b0c}#stage:fullscreen canvas{width:min(100vw,177.777778vh);height:auto;aspect-ratio:16/9}
#stage.expanded{position:fixed;inset:0;z-index:5;width:100vw;height:100dvh;display:grid;place-items:center;background:#0a0b0c}#stage.expanded canvas{width:min(100vw,177.777778dvh);height:auto;aspect-ratio:16/9}#exit{position:absolute;right:16px;top:16px;background:#17191be0}
@media(max-width:620px){main{width:100%;padding:16px 0}header,#controls{margin-left:12px;margin-right:12px}h1{font-size:24px}button{padding:6px 8px;font-size:12px}nav{gap:5px}}
aside{display:flex;gap:20px;margin:18px 0 0}aside a{font-size:14px;color:#d6b893;text-underline-offset:3px}html.render aside{display:none}@media(max-width:620px){aside{padding:0 12px}}</style></head><body><main><header><h1>The Sun, Again<span>RIPTIDE</span></h1><time id="time">0:00 / 0:26.5</time></header><div id="stage"><canvas id="view" width="1280" height="720"></canvas><div id="notice">Loading the paintings…</div><button id="exit" hidden>Exit full screen</button></div>
<div id="controls"><input id="scrub" type="range" aria-label="Film timeline" min="0" max="26.5" step=".001" value="0"><nav><button id="play">Play</button><div id="chapters"></div><button id="mute" aria-label="Mute">Sound on</button><button id="fs" aria-label="Full screen">Full screen</button></nav></div>
<audio id="score" loop preload="auto" src="@@AUDIO@@"></audio><aside><a href="making-of.html">How it was made</a><a href="https://github.com/Andy-Huang-SZU/riptide-flight">Source on GitHub</a><a href="docs/riptide.mp4">Watch MP4</a></aside></main>
<script>@@THREE@@</script><script>@@LOADER@@</script><script>const SCORE=@@SCORE@@;const ASSETS=@@ASSETS@@;const RIG='@@RIG@@';</script>
<script>@@SURFACE@@</script><script>@@FLIGHT@@</script><script>@@TRACES@@</script><script>@@STAMPS@@</script><script>@@PRINT@@</script><script>@@PAPER@@</script><script>@@TIDE@@</script><script>@@FILM@@</script><script>@@PLAY@@</script></body></html>
